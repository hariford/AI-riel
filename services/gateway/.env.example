# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=8080

# Local dev without Entra: act as a fixed admin user (refused in production).
AUTH_DISABLED=true
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_USERS_GROUP_ID=
ENTRA_ADMINS_GROUP_ID=

# Azure AI Foundry project endpoint, e.g. https://airiel-foundry.openai.azure.com/
FOUNDRY_ENDPOINT=
FOUNDRY_API_VERSION=2024-10-21
# Leave empty to use managed identity / az login (DefaultAzureCredential)
FOUNDRY_API_KEY=
FOUNDRY_DEPLOYMENT_DEFAULT=gpt-4.1
FOUNDRY_DEPLOYMENT_SMALL=gpt-4.1-mini
FOUNDRY_CONTEXT_WINDOW=128000

SPEECH_REGION=australiaeast
SPEECH_KEY=

# Empty = in-memory usage store
SQL_CONNECTION_STRING=

DAILY_TOKEN_BUDGET=0
